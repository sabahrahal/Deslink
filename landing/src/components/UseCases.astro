---
import type { ComponentProps } from 'astro/types';
import Icon from './Icon.astro';

type IconName = ComponentProps<typeof Icon>['name'];

const cases: { id: string; icon: IconName; tab: string; title: string; text: string; points: string[] }[] = [
  {
    id: 'codigo',
    icon: 'code',
    tab: 'Programar',
    title: 'El código en grande, la documentación al lado',
    text: 'Deja el editor en el monitor principal y pon en la tablet la documentación, la terminal o la app que estás probando. Se acabó saltar entre ventanas.',
    points: ['Terminal o logs siempre a la vista', 'Gira la tablet para leer en vertical', 'Desplaza con dos dedos'],
  },
  {
    id: 'diseno',
    icon: 'pen',
    tab: 'Diseñar',
    title: 'Tu tablet como lienzo y paleta',
    text: 'Paneles de herramientas, capas o referencias en la tablet y el lienzo en el monitor grande. Con el táctil directo, tocas los botones como en cualquier pantalla táctil.',
    points: ['Multitáctil con presión', 'Pellizca para hacer zoom', 'Mantén pulsado para el clic derecho'],
  },
  {
    id: 'video',
    icon: 'film',
    tab: 'Editar vídeo',
    title: 'Más línea de tiempo, menos ventanas apiladas',
    text: 'Lleva la vista previa o los medios a la tablet y gana el monitor entero para la línea de tiempo. Hasta 120 fps para que la reproducción se vea fluida.',
    points: ['Vista previa a 120 fps', 'Sonido del PC en la tablet', 'HEVC: más calidad con menos datos'],
  },
  {
    id: 'bolsa',
    icon: 'chart',
    tab: 'Mercados',
    title: 'Gráficas y cotizaciones siempre abiertas',
    text: 'Un monitor más para tus gráficas, alertas o paneles, sin comprar otra pantalla. Si la tablet está enchufada al PC, la batería no es problema.',
    points: ['Pantalla siempre encendida en sesión', 'Cable USB: sin cortes', 'Perfil Ahorro para jornadas largas'],
  },
  {
    id: 'musica',
    icon: 'music',
    tab: 'Música',
    title: 'Un mezclador táctil para tu estudio',
    text: 'Pon el mezclador o los plugins en la tablet y mueve los controles con los dedos mientras el proyecto ocupa el monitor principal.',
    points: ['Táctil directo con varios dedos', 'Retardo mínimo por cable', 'Elige dónde suena el PC'],
  },
  {
    id: 'clase',
    icon: 'video',
    tab: 'Clases y reuniones',
    title: 'La videollamada a un lado, tus apuntes al otro',
    text: 'Deja la reunión o la clase en la tablet y trabaja en el PC sin perder de vista a nadie. Perfecto para estudiar con el portátil en la biblioteca.',
    points: ['Ideal con portátil', 'Wi-Fi sin configurar nada', 'Modo «Solo ver» si no quieres tocar'],
  },
];
---

<section id="usos" class="uses">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Ejemplos de uso</span>
      <h2>Una pantalla más, <span class="gradient-text">mil formas de usarla</span></h2>
      <p>Ese móvil o esa tablet que tienes en el cajón puede ser el monitor que te faltaba.</p>
    </div>

    <div class="tabs" role="tablist" aria-label="Ejemplos de uso" data-reveal>
      {
        cases.map((c, i) => (
          <button
            role="tab"
            id={`tab-${c.id}`}
            aria-controls={`panel-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <Icon name={c.icon} size={18} />
            {c.tab}
          </button>
        ))
      }
    </div>

    <div class="panels" data-reveal="zoom">
      {
        cases.map((c, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${c.id}`}
            aria-labelledby={`tab-${c.id}`}
            data-active={i === 0 ? '' : undefined}
            hidden={i !== 0}
          >
            <div class="text">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              <ul>
                {c.points.map((p) => (
                  <li>
                    <Icon name="check" size={18} />
                    {p}
                  </li>
                ))}
              </ul>
            </div>
            <div class={`scene scene-${c.id}`} aria-hidden="true">
              <div class="desk">
                <div class="mon">
                  <div class="mon-screen">
                    <i />
                    <i />
                    <i />
                    <i />
                    <i />
                    <i />
                  </div>
                </div>
                <div class="tab">
                  <div class="tab-screen">
                    <i />
                    <i />
                    <i />
                    <i />
                    <i />
                    <i />
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
      <div class="timer" aria-hidden="true"><span></span></div>
    </div>
  </div>
</section>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }
  [role='tab'] {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    font: 600 15px var(--font-body);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s,
      transform 0.25s;
  }
  [role='tab']:hover {
    color: var(--text);
    transform: translateY(-2px);
  }
  [role='tab'][aria-selected='true'] {
    background: linear-gradient(135deg, var(--brand-600), var(--brand-800));
    border-color: transparent;
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(112, 51, 253, 0.9);
  }

  .panels {
    position: relative;
    border-radius: 28px;
    border: 1px solid var(--border);
    background:
      radial-gradient(600px circle at 85% 20%, rgba(255, 95, 210, 0.14), transparent 60%),
      radial-gradient(600px circle at 10% 90%, rgba(112, 51, 253, 0.2), transparent 60%),
      var(--bg-2);
    overflow: hidden;
  }
  .panel {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 40px;
    align-items: center;
    padding: 48px;
  }
  .panel[hidden] {
    display: none;
  }
  .panel[data-active] .text > * {
    animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .panel[data-active] .text > :nth-child(2) {
    animation-delay: 0.08s;
  }
  .panel[data-active] .text > :nth-child(3) {
    animation-delay: 0.16s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .text h3 {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 900;
    margin-bottom: 16px;
  }
  .text p {
    color: var(--text-2);
    font-size: 18px;
  }
  .text ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 10px;
  }
  .text li {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .text li :global(svg) {
    color: var(--green);
    flex: none;
  }

  /* Escena genérica: monitor + tablet, el contenido cambia por caso. */
  .scene {
    perspective: 1200px;
  }
  .desk {
    position: relative;
    height: 320px;
    transform: rotateY(-10deg) rotateX(4deg);
    transform-style: preserve-3d;
  }
  .panel[data-active] .desk {
    animation: swing 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes swing {
    from {
      opacity: 0;
      transform: rotateY(-30deg) rotateX(10deg) translateX(40px);
    }
  }
  .mon {
    position: absolute;
    left: 0;
    top: 20px;
    width: 66%;
    aspect-ratio: 16 / 10;
    padding: 8px;
    border-radius: 14px;
    background: #231a3d;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }
  .tab {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 40%;
    aspect-ratio: 4 / 3;
    padding: 8px;
    border-radius: 16px;
    background: #231a3d;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 30px 60px -20px rgba(112, 51, 253, 0.6);
    transform: translateZ(40px);
  }
  .mon-screen,
  .tab-screen {
    position: relative;
    height: 100%;
    border-radius: 8px;
    background: #f5f5f7;
    overflow: hidden;
  }
  .mon-screen i,
  .tab-screen i {
    position: absolute;
    display: block;
    border-radius: 3px;
  }

  /* Programar: líneas de código y terminal */
  .scene-codigo .mon-screen {
    background: #1c1830;
  }
  .scene-codigo .mon-screen i {
    left: 8%;
    height: 6px;
    background: var(--brand-300);
    animation: type 3s steps(12) infinite;
    transform-origin: left;
  }
  .scene-codigo .mon-screen i:nth-child(1) {
    top: 12%;
    width: 40%;
  }
  .scene-codigo .mon-screen i:nth-child(2) {
    top: 24%;
    width: 55%;
    left: 14%;
    background: var(--pink);
    animation-delay: 0.3s;
  }
  .scene-codigo .mon-screen i:nth-child(3) {
    top: 36%;
    width: 35%;
    left: 14%;
    background: var(--cyan);
    animation-delay: 0.6s;
  }
  .scene-codigo .mon-screen i:nth-child(4) {
    top: 48%;
    width: 60%;
    left: 20%;
    animation-delay: 0.9s;
  }
  .scene-codigo .mon-screen i:nth-child(5) {
    top: 60%;
    width: 30%;
    left: 14%;
    background: var(--green);
    animation-delay: 1.2s;
  }
  .scene-codigo .mon-screen i:nth-child(6) {
    top: 72%;
    width: 20%;
    animation-delay: 1.5s;
  }
  @keyframes type {
    0% {
      transform: scaleX(0);
    }
    40%,
    100% {
      transform: scaleX(1);
    }
  }
  .scene-codigo .tab-screen {
    background: #0e0b18;
  }
  .scene-codigo .tab-screen i {
    left: 8%;
    height: 5px;
    background: var(--green);
    opacity: 0.8;
    animation: scrollup 2.4s linear infinite;
  }
  .scene-codigo .tab-screen i:nth-child(1) {
    top: 10%;
    width: 70%;
  }
  .scene-codigo .tab-screen i:nth-child(2) {
    top: 25%;
    width: 50%;
  }
  .scene-codigo .tab-screen i:nth-child(3) {
    top: 40%;
    width: 80%;
    background: var(--brand-300);
  }
  .scene-codigo .tab-screen i:nth-child(4) {
    top: 55%;
    width: 40%;
  }
  .scene-codigo .tab-screen i:nth-child(5) {
    top: 70%;
    width: 65%;
  }
  .scene-codigo .tab-screen i:nth-child(6) {
    top: 85%;
    width: 30%;
    background: var(--pink);
  }
  @keyframes scrollup {
    to {
      transform: translateY(-30px);
    }
  }

  /* Diseñar: lienzo con formas, paleta en la tablet */
  .scene-diseno .mon-screen i:nth-child(1) {
    left: 18%;
    top: 20%;
    width: 30%;
    height: 50%;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-600), var(--pink));
    animation: morph 4s ease-in-out infinite;
  }
  .scene-diseno .mon-screen i:nth-child(2) {
    left: 52%;
    top: 30%;
    width: 26%;
    height: 40%;
    background: var(--cyan);
    border-radius: 12px;
    animation: morph 4s ease-in-out infinite reverse;
  }
  .scene-diseno .mon-screen i:nth-child(n + 3) {
    display: none;
  }
  @keyframes morph {
    50% {
      border-radius: 20% 60% 40% 70%;
      transform: rotate(20deg) scale(1.08);
    }
  }
  .scene-diseno .tab-screen {
    background: #2a2142;
  }
  .scene-diseno .tab-screen i {
    width: 24%;
    height: 32%;
    border-radius: 50%;
    animation: pick 3s ease-in-out infinite;
  }
  .scene-diseno .tab-screen i:nth-child(1) {
    left: 6%;
    top: 12%;
    background: var(--brand-600);
  }
  .scene-diseno .tab-screen i:nth-child(2) {
    left: 38%;
    top: 12%;
    background: var(--pink);
    animation-delay: 0.5s;
  }
  .scene-diseno .tab-screen i:nth-child(3) {
    left: 70%;
    top: 12%;
    background: var(--cyan);
    animation-delay: 1s;
  }
  .scene-diseno .tab-screen i:nth-child(4) {
    left: 6%;
    top: 56%;
    background: var(--green);
    animation-delay: 1.5s;
  }
  .scene-diseno .tab-screen i:nth-child(5) {
    left: 38%;
    top: 56%;
    background: #ffd60a;
    animation-delay: 2s;
  }
  .scene-diseno .tab-screen i:nth-child(6) {
    left: 70%;
    top: 56%;
    background: #fff;
    animation-delay: 2.5s;
  }
  @keyframes pick {
    10% {
      transform: scale(0.8);
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.6);
    }
    25% {
      transform: none;
      box-shadow: none;
    }
  }

  /* Editar vídeo: línea de tiempo en el monitor, vista previa en la tablet */
  .scene-video .mon-screen {
    background: #1c1830;
  }
  .scene-video .mon-screen i {
    height: 12%;
    border-radius: 4px;
  }
  .scene-video .mon-screen i:nth-child(1) {
    left: 4%;
    top: 50%;
    width: 40%;
    background: var(--brand-600);
  }
  .scene-video .mon-screen i:nth-child(2) {
    left: 46%;
    top: 50%;
    width: 30%;
    background: var(--brand-300);
  }
  .scene-video .mon-screen i:nth-child(3) {
    left: 10%;
    top: 66%;
    width: 50%;
    background: var(--pink);
  }
  .scene-video .mon-screen i:nth-child(4) {
    left: 4%;
    top: 82%;
    width: 80%;
    background: var(--cyan);
    opacity: 0.6;
    height: 8%;
  }
  .scene-video .mon-screen i:nth-child(5) {
    left: 4%;
    top: 44%;
    width: 2px;
    height: 50%;
    background: #fff;
    border-radius: 0;
    animation: playhead 4s linear infinite;
  }
  .scene-video .mon-screen i:nth-child(6) {
    left: 4%;
    top: 8%;
    width: 92%;
    height: 28%;
    background: rgba(255, 255, 255, 0.06);
  }
  @keyframes playhead {
    to {
      left: 92%;
    }
  }
  .scene-video .tab-screen {
    background: linear-gradient(135deg, #46e0ff, #7033fd 50%, #ff5fd2);
    background-size: 300% 300%;
    animation: film 5s ease infinite;
  }
  .scene-video .tab-screen i {
    display: none;
  }
  .scene-video .tab-screen i:first-child {
    display: block;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    margin: -14px 0 0 -9px;
    border-radius: 0;
    border-left: 24px solid rgba(255, 255, 255, 0.9);
    border-top: 14px solid transparent;
    border-bottom: 14px solid transparent;
  }
  @keyframes film {
    50% {
      background-position: 100% 100%;
    }
  }

  /* Mercados: gráfica que se dibuja y velas */
  .scene-bolsa .mon-screen {
    background:
      linear-gradient(transparent 95%, rgba(0, 0, 0, 0.06) 95%) 0 0 / 100% 20%,
      #fff;
  }
  .scene-bolsa .mon-screen i {
    bottom: 12%;
    width: 7%;
    background: var(--green);
    animation: candle 2.5s ease-in-out infinite alternate;
    transform-origin: bottom;
  }
  .scene-bolsa .mon-screen i:nth-child(1) {
    left: 8%;
    height: 30%;
  }
  .scene-bolsa .mon-screen i:nth-child(2) {
    left: 22%;
    height: 45%;
    background: #ff6961;
    animation-delay: 0.3s;
  }
  .scene-bolsa .mon-screen i:nth-child(3) {
    left: 36%;
    height: 38%;
    animation-delay: 0.6s;
  }
  .scene-bolsa .mon-screen i:nth-child(4) {
    left: 50%;
    height: 58%;
    animation-delay: 0.9s;
  }
  .scene-bolsa .mon-screen i:nth-child(5) {
    left: 64%;
    height: 50%;
    background: #ff6961;
    animation-delay: 1.2s;
  }
  .scene-bolsa .mon-screen i:nth-child(6) {
    left: 78%;
    height: 72%;
    animation-delay: 1.5s;
  }
  @keyframes candle {
    to {
      transform: scaleY(0.7);
    }
  }
  .scene-bolsa .tab-screen {
    background: #0e0b18;
  }
  .scene-bolsa .tab-screen i {
    left: 8%;
    width: 84%;
    height: 12%;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
  }
  .scene-bolsa .tab-screen i::after {
    content: '';
    position: absolute;
    right: 8%;
    top: 30%;
    width: 22%;
    height: 40%;
    border-radius: 3px;
    background: var(--green);
    animation: tick 1.6s steps(2) infinite;
  }
  .scene-bolsa .tab-screen i:nth-child(1) {
    top: 8%;
  }
  .scene-bolsa .tab-screen i:nth-child(2) {
    top: 24%;
  }
  .scene-bolsa .tab-screen i:nth-child(3) {
    top: 40%;
  }
  .scene-bolsa .tab-screen i:nth-child(4) {
    top: 56%;
  }
  .scene-bolsa .tab-screen i:nth-child(5) {
    top: 72%;
  }
  .scene-bolsa .tab-screen i:nth-child(2)::after,
  .scene-bolsa .tab-screen i:nth-child(5)::after {
    background: #ff6961;
    animation-delay: 0.8s;
  }
  .scene-bolsa .tab-screen i:nth-child(6) {
    display: none;
  }
  @keyframes tick {
    50% {
      opacity: 0.4;
    }
  }

  /* Música: faders que suben y bajan */
  .scene-musica .mon-screen {
    background: #1c1830;
  }
  .scene-musica .mon-screen i {
    left: 6%;
    width: 88%;
    height: 8%;
    background: var(--brand-600);
    opacity: 0.8;
  }
  .scene-musica .mon-screen i:nth-child(1) {
    top: 12%;
    width: 50%;
  }
  .scene-musica .mon-screen i:nth-child(2) {
    top: 26%;
    left: 30%;
    width: 40%;
    background: var(--pink);
  }
  .scene-musica .mon-screen i:nth-child(3) {
    top: 40%;
    left: 12%;
    width: 60%;
    background: var(--cyan);
  }
  .scene-musica .mon-screen i:nth-child(4) {
    top: 54%;
    left: 44%;
    width: 46%;
  }
  .scene-musica .mon-screen i:nth-child(5) {
    top: 68%;
    width: 30%;
    background: var(--green);
  }
  .scene-musica .mon-screen i:nth-child(6) {
    top: 6%;
    bottom: 6%;
    height: auto;
    left: 40%;
    width: 2px;
    background: #fff;
    opacity: 1;
    animation: playhead 3s linear infinite;
  }
  .scene-musica .tab-screen {
    background: #2a2142;
  }
  .scene-musica .tab-screen i {
    top: 15%;
    width: 8%;
    height: 70%;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
  }
  .scene-musica .tab-screen i::after {
    content: '';
    position: absolute;
    left: -40%;
    width: 180%;
    height: 14%;
    border-radius: 4px;
    background: var(--brand-300);
    animation: fader 2.2s ease-in-out infinite alternate;
  }
  .scene-musica .tab-screen i:nth-child(1) {
    left: 8%;
  }
  .scene-musica .tab-screen i:nth-child(2) {
    left: 24%;
  }
  .scene-musica .tab-screen i:nth-child(3) {
    left: 40%;
  }
  .scene-musica .tab-screen i:nth-child(4) {
    left: 56%;
  }
  .scene-musica .tab-screen i:nth-child(5) {
    left: 72%;
  }
  .scene-musica .tab-screen i:nth-child(6) {
    left: 88%;
    width: 4%;
  }
  .scene-musica .tab-screen i:nth-child(2)::after {
    animation-delay: -0.6s;
    background: var(--pink);
  }
  .scene-musica .tab-screen i:nth-child(3)::after {
    animation-delay: -1.2s;
  }
  .scene-musica .tab-screen i:nth-child(4)::after {
    animation-delay: -0.3s;
    background: var(--cyan);
  }
  .scene-musica .tab-screen i:nth-child(5)::after {
    animation-delay: -1.6s;
  }
  .scene-musica .tab-screen i:nth-child(6)::after {
    display: none;
  }
  @keyframes fader {
    from {
      top: 80%;
    }
    to {
      top: 6%;
    }
  }

  /* Clases y reuniones: rejilla de videollamada */
  .scene-clase .mon-screen i {
    left: 8%;
    height: 6px;
    background: #d2d2d7;
  }
  .scene-clase .mon-screen i:nth-child(1) {
    top: 14%;
    width: 40%;
    height: 10px;
    background: var(--brand-900);
  }
  .scene-clase .mon-screen i:nth-child(2) {
    top: 30%;
    width: 80%;
  }
  .scene-clase .mon-screen i:nth-child(3) {
    top: 40%;
    width: 74%;
  }
  .scene-clase .mon-screen i:nth-child(4) {
    top: 50%;
    width: 78%;
  }
  .scene-clase .mon-screen i:nth-child(5) {
    top: 60%;
    width: 50%;
  }
  .scene-clase .mon-screen i:nth-child(6) {
    top: 70%;
    width: 0;
    background: var(--brand-600);
    animation: write 3s steps(10) infinite;
  }
  @keyframes write {
    to {
      width: 60%;
    }
  }
  .scene-clase .tab-screen {
    background: #0e0b18;
  }
  .scene-clase .tab-screen i {
    width: 29%;
    height: 42%;
    border-radius: 6px;
    background: linear-gradient(160deg, #3a2d63, #231a3d);
  }
  .scene-clase .tab-screen i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 30%;
    width: 30%;
    aspect-ratio: 1;
    margin-left: -15%;
    border-radius: 50%;
    background: var(--brand-300);
  }
  .scene-clase .tab-screen i:nth-child(1) {
    left: 4%;
    top: 6%;
    box-shadow: 0 0 0 2px var(--green);
    animation: talk 1.2s ease-in-out infinite;
  }
  .scene-clase .tab-screen i:nth-child(2) {
    left: 35.5%;
    top: 6%;
  }
  .scene-clase .tab-screen i:nth-child(3) {
    left: 67%;
    top: 6%;
  }
  .scene-clase .tab-screen i:nth-child(4) {
    left: 4%;
    top: 52%;
  }
  .scene-clase .tab-screen i:nth-child(5) {
    left: 35.5%;
    top: 52%;
  }
  .scene-clase .tab-screen i:nth-child(6) {
    left: 67%;
    top: 52%;
  }
  .scene-clase .tab-screen i:nth-child(2)::after,
  .scene-clase .tab-screen i:nth-child(5)::after {
    background: var(--pink);
  }
  .scene-clase .tab-screen i:nth-child(3)::after,
  .scene-clase .tab-screen i:nth-child(6)::after {
    background: var(--cyan);
  }
  @keyframes talk {
    50% {
      box-shadow: 0 0 0 4px rgba(48, 209, 88, 0.4);
    }
  }

  .timer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.05);
  }
  .timer span {
    display: block;
    height: 100%;
    background: var(--grad);
    transform-origin: left;
    transform: scaleX(0);
  }
  .timer span.run {
    animation: timer var(--dur, 6s) linear forwards;
  }
  @keyframes timer {
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 900px) {
    .panel {
      grid-template-columns: 1fr;
      padding: 32px 22px;
    }
    .desk {
      height: 250px;
      max-width: 460px;
      margin: 0 auto;
    }
  }
  @media (max-width: 520px) {
    .tabs {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      margin: 0 -16px 24px;
      padding: 4px 16px 10px;
      scrollbar-width: none;
    }
    [role='tab'] {
      flex: none;
    }
    .desk {
      height: 200px;
    }
  }
</style>

<script>
  const DURATION = 6000;
  const root = document.getElementById('usos')!;
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
  const bar = root.querySelector<HTMLElement>('.timer span')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = 0;
  let auto = !reduced;
  let timer: number | undefined;
  let inView = false;

  function select(i: number, focus = false) {
    current = (i + tabs.length) % tabs.length;
    tabs.forEach((t, j) => {
      const on = j === current;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      panels[j].hidden = !on;
      panels[j].toggleAttribute('data-active', on);
    });
    if (focus) {
      tabs[current].focus();
      tabs[current].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    }
    schedule();
  }

  function schedule() {
    window.clearTimeout(timer);
    bar.classList.remove('run');
    if (!auto || !inView) return;
    void bar.offsetWidth; // reinicia la animación de la barra
    bar.style.setProperty('--dur', `${DURATION}ms`);
    bar.classList.add('run');
    timer = window.setTimeout(() => select(current + 1), DURATION);
  }

  const stopAuto = () => {
    auto = false;
    schedule();
  };

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => {
      stopAuto();
      select(i);
    });
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        stopAuto();
        select(current + (e.key === 'ArrowRight' ? 1 : -1), true);
      }
    });
  });

  new IntersectionObserver(
    ([entry]) => {
      inView = entry.isIntersecting;
      schedule();
    },
    { threshold: 0.35 },
  ).observe(root);
</script>
