---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { DOWNLOADS, REPO } from '../config';

const year = new Date().getFullYear();
---

<section class="final">
  <div class="container" data-reveal="zoom">
    <div class="cta">
      <div class="rings" aria-hidden="true"><span></span><span></span><span></span></div>
      <Logo size={56} wordmark={false} />
      <h2>Ese dispositivo del cajón<br /><span class="gradient-text">quiere volver a trabajar.</span></h2>
      <div class="actions">
        <a class="btn btn-primary" href={DOWNLOADS.windows}><Icon name="windows" />Windows</a>
        <a class="btn btn-ghost" href={DOWNLOADS.android}><Icon name="android" />Android</a>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="container row">
    <Logo size={22} />
    <nav aria-label="Pie de página">
      <a href="#caracteristicas">Características</a>
      <a href="#usos">Usos</a>
      <a href="#descargar">Descargar</a>
      <a href="#faq">Preguntas</a>
      <a href="#contacto">Contacto</a>
      <a href={REPO} target="_blank" rel="noopener">GitHub</a>
    </nav>
    <small>© {year} DeskLink. Windows es una marca de Microsoft y Android, de Google.</small>
  </div>
</footer>

<style>
  .final {
    padding-top: 40px;
  }
  .cta {
    position: relative;
    text-align: center;
    padding: 90px 24px;
    border-radius: 32px;
    overflow: hidden;
    background: linear-gradient(135deg, #3f0d91, #4d13c7 45%, #7033fd);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }
  .cta :global(.logo svg path) {
    fill: #fff;
  }
  .cta :global(.logo svg path:first-child) {
    fill: rgba(255, 255, 255, 0.55);
  }
  .rings span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 300px;
    height: 300px;
    margin: -150px 0 0 -150px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    animation: ring 6s linear infinite;
  }
  .rings span:nth-child(2) {
    animation-delay: -2s;
  }
  .rings span:nth-child(3) {
    animation-delay: -4s;
  }
  @keyframes ring {
    from {
      transform: scale(0.4);
      opacity: 1;
    }
    to {
      transform: scale(3.4);
      opacity: 0;
    }
  }
  h2 {
    position: relative;
    font-size: clamp(30px, 5vw, 56px);
    font-weight: 900;
  }
  .cta .gradient-text {
    background-image: linear-gradient(120deg, #fff, #ffc8f0, #fff);
  }
  .actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .cta .btn-primary {
    background: #fff;
    color: var(--brand-900);
  }
  .cta .btn-ghost {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.35);
  }

  footer {
    padding: 48px 0 40px;
    border-top: 1px solid var(--border);
    margin-top: 40px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
  }
  footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-left: auto;
  }
  footer nav a {
    color: var(--text-2);
    font-size: 15px;
  }
  footer nav a:hover {
    color: var(--text);
  }
  small {
    flex-basis: 100%;
    color: var(--text-3);
    font-size: 13px;
  }
  @media (max-width: 700px) {
    footer nav {
      margin-left: 0;
    }
    .cta {
      padding: 64px 20px;
    }
  }
</style>
