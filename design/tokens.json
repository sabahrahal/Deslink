{
  "_comment": "Fuente única de colores, texto y formas de DeskLink (PC y tablet). Se edita aquí y se ejecuta python3 tools/design/gen_tokens.py; ver docs/design.md.",
  "colors": {
    "background":        { "light": "#F5F5F7", "dark": "#1C1C1E", "use": "Fondo de pantalla" },
    "surface":           { "light": "#FFFFFF", "dark": "#2C2C2E", "use": "Tarjetas" },
    "surface_secondary": { "light": "#ECECF0", "dark": "#3A3A3C", "use": "Campos y opciones sin elegir" },
    "separator":         { "light": "#D2D2D7", "dark": "#48484A", "use": "Bordes y líneas" },
    "text":              { "light": "#1D1D1F", "dark": "#F5F5F7", "use": "Texto y títulos" },
    "text_secondary":    { "light": "#5E5E63", "dark": "#AEAEB2", "use": "Explicaciones" },
    "accent":            { "light": "#0066CC", "dark": "#409CFF", "use": "Botón principal, selección, enlaces" },
    "on_accent":         { "light": "#FFFFFF", "dark": "#000000", "use": "Texto sobre el acento" },
    "success":           { "light": "#1E7D34", "dark": "#30D158", "use": "Conectado" },
    "warning":           { "light": "#A84B00", "dark": "#FF9F0A", "use": "Avisos" },
    "error":             { "light": "#D70015", "dark": "#FF6961", "use": "Errores" }
  },
  "contrast": {
    "_comment": "Pares que deben leerse: [texto, fondo, mínimo]. 4.5 para texto normal (WCAG AA).",
    "pairs": [
      ["text", "background", 4.5], ["text", "surface", 4.5], ["text", "surface_secondary", 4.5],
      ["text_secondary", "background", 4.5], ["text_secondary", "surface", 4.5], ["text_secondary", "surface_secondary", 4.5],
      ["accent", "background", 4.5], ["accent", "surface", 4.5],
      ["on_accent", "accent", 4.5],
      ["success", "surface", 4.5], ["warning", "surface", 4.5], ["error", "surface", 4.5],
      ["success", "background", 4.5], ["warning", "background", 4.5], ["error", "background", 4.5]
    ]
  },
  "type": {
    "large_title": { "size": 28, "weight": 600, "use": "Nombre de la pantalla" },
    "title":       { "size": 20, "weight": 600, "use": "Título de tarjeta" },
    "headline":    { "size": 17, "weight": 600, "use": "Nombre de un PC o de una opción" },
    "section":     { "size": 13, "weight": 600, "use": "Encabezado de sección, en color secundario" },
    "body":        { "size": 15, "weight": 400, "use": "Texto normal" },
    "note":        { "size": 13, "weight": 400, "use": "Explicaciones bajo una opción" }
  },
  "shape": {
    "card_radius": 12,
    "control_radius": 8,
    "spacing": [4, 8, 12, 16, 24]
  }
}
