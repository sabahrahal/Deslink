;
; desklink-idd.inf: monitor virtual de Extendesk (Indirect Display Driver, UMDF)
; Los nombres de archivo, secciones, servicio e id de hardware (DeskLink...) son los de antes del nombre Extendesk y se
; conservan: así los equipos que ya lo tienen lo actualizan y lo desinstalan como siempre.
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=desklink-idd.cat
DriverVer=

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%DeviceName%=DeskLink_Install, Root\DeskLinkIdd

[SourceDisksFiles]
desklink-idd.dll=1

[SourceDisksNames]
1=%DiskName%

[DeskLink_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[DeskLink_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=DeskLink_HardwareDeviceSettings

[DeskLink_HardwareDeviceSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"DeskLinkIddGroup"
; Por defecto solo SYSTEM y administradores abren el dispositivo; el host corre con el usuario normal.
; Se da lectura y escritura a «Usuarios» (BU): solo sirve para enchufar y quitar el monitor virtual.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;BU)"

[DeskLink_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[DeskLink_Install.NT.Wdf]
UmdfService=DeskLinkIdd,DeskLinkIdd_Install
UmdfServiceOrder=DeskLinkIdd
UmdfKernelModeClientPolicy=AllowKernelModeClients

[DeskLinkIdd_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\desklink-idd.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF

[UMDriverCopy]
desklink-idd.dll

[Strings]
ManufacturerName="Extendesk"
DiskName="Extendesk"
DeviceName="Extendesk monitor virtual"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
