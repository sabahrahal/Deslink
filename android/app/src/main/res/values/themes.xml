<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fondo oscuro desde el primer fotograma (sin destello blanco al abrir). Colores: docs/design.md -->
    <style name="Theme.DeskLink" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dl_background</item>
        <item name="android:colorAccent">@color/dl_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DeskLink.Stream">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
